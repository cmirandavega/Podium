
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if request.auth.uid == uid
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'active';
      allow update: if (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status)
                    || isAdmin();
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /sports/{sport} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    function isCommissionerOf(leagueId) {
      return signedIn() &&
        get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerId == request.auth.uid;
    }

    function isMemberOf(leagueId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds;
    }

    // Use Case 2. Joining only adds the caller to memberIds, before the
    // season starts and while there's room. Commissioners and admins can
    // change league settings.
    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.commissionerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.format in ['single-sport', 'multi-sport']
                    && request.resource.data.sports.size() > 0;
      allow update: if signedIn() && (
          resource.data.commissionerId == request.auth.uid
          || isAdmin()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
              && resource.data.phase == 'preseason'
              && !(request.auth.uid in resource.data.memberIds)
              && request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && request.auth.uid in request.resource.data.memberIds
              && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
              && request.resource.data.memberIds.size() <= resource.data.maxTeams));
      allow delete: if signedIn()
        && (resource.data.commissionerId == request.auth.uid || isAdmin());

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && request.resource.data.isMuted == false
                      && request.resource.data.coins == 1000
                      && uid in getAfter(/databases/$(database)/documents/leagues/$(leagueId)).data.memberIds;
        // Admins can change anything; the commissioner can mute or unmute
        // (Use Case 7).
        allow update: if isAdmin()
                      || (resource.data.userId != request.auth.uid
                          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.commissionerId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isMuted']));
      }

      // Use Case 7. Members who aren't muted can post as themselves.
      // Senders, the commissioner, and admins can soft-delete a message.
      match /messages/{messageId} {
        function league() {
          return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
        }

        allow read: if signedIn() && (request.auth.uid in league().memberIds || isAdmin());
        allow create: if signedIn()
                      && request.auth.uid in league().memberIds
                      && get(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid)).data.isMuted == false
                      && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'body', 'isDeleted', 'createdAt'])
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 500
                      && request.resource.data.isDeleted == false
                      && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
                      && (resource.data.senderId == request.auth.uid
                          || league().commissionerId == request.auth.uid
                          || isAdmin())
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'body'])
                      && request.resource.data.isDeleted == true
                      && request.resource.data.body == '';
      }
    }

    // A leagueSports row can only point at the league it's named after.
    match /leagueSports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && id == request.resource.data.leagueId + '_' + request.resource.data.sportName
                    && getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.commissionerId == request.auth.uid;
      allow delete: if isCommissionerOf(resource.data.leagueId);
    }

    // Use Case 3. One team per user per league: the doc ID is
    // {leagueId}_{ownerId}, and the owner must be a league member (checked
    // after the batch that creates the membership).
    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && teamId == request.resource.data.leagueId + '_' + request.auth.uid
                    && request.auth.uid in getAfter(/databases/$(database)/documents/leagues/$(request.resource.data.leagueId)).data.memberIds;
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName']);
    }

    // Use Case 3. The doc ID {leagueId}_{playerId} means a player is on at
    // most one roster per league. Owners change only their own team, only
    // with players from the league's sports, and not while lineups are locked.
    match /rosterSlots/{slotId} {
      function slotLeague(leagueId) {
        return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
      }

      function ownTeamId(leagueId) {
        return leagueId + '_' + request.auth.uid;
      }

      allow read: if signedIn();
      allow create: if signedIn()
                    && slotId == request.resource.data.leagueId + '_' + request.resource.data.playerId
                    && request.resource.data.teamId == ownTeamId(request.resource.data.leagueId)
                    && slotLeague(request.resource.data.leagueId).lineupLocked == false
                    && request.resource.data.sport in slotLeague(request.resource.data.leagueId).sports;
      allow update: if signedIn()
                    && resource.data.teamId == ownTeamId(resource.data.leagueId)
                    && slotLeague(resource.data.leagueId).lineupLocked == false
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isStarter']);
      allow delete: if signedIn()
                    && resource.data.teamId == ownTeamId(resource.data.leagueId)
                    && slotLeague(resource.data.leagueId).lineupLocked == false;
    }

    match /leaderboard/{entryId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    } 
    // Written only by the ingestion script (Admin SDK); readable by any signed-in user.
    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /playerStats/{statId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /scoringPeriods/{periodId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // User reporting and admin review
    match /reports/{reportId} {

      // Only admins can read submitted reports.
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterId == request.auth.uid);

      // Signed-in users can submit reports about other players.
      allow create: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status in ['active', 'warned']
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reportedUserId',
          'reason',
          'details',
          'status',
          'createdAt',
          'reviewedAt',
          'reviewedBy'
        ])
        && request.resource.data.keys().hasAll([
          'reporterId',
          'reportedUserId',
          'reason',
          'details',
          'status',
          'createdAt',
          'reviewedAt',
          'reviewedBy'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.reportedUserId))
        && get(/databases/$(database)/documents/users/$(request.resource.data.reportedUserId)).data.role == 'user'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null;

      // Only admins can review pending reports.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'status',
            'reviewedAt',
            'reviewedBy'
          ])
        && request.resource.data.status in [
          'dismissed',
          'warned',
          'suspended'
        ]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    match /moderationNotices/{noticeId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'userId', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'userId', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.userId is string
        && request.resource.data.reason is string
        && request.resource.data.status in ['warned', 'suspended']
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
    // Use Case 6: users see only their own notifications and can only mark them read.
    // Admins can send notifications to any user (for example, account status changes).
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && (request.resource.data.userId == request.auth.uid || isAdmin())
                    && request.resource.data.isRead == false;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
    }

    // Use Case 12. Each team's Coach conversation is private to its owner.
    // The doc ID is the team ID, which starts with the league ID and ends
    // with the owner's uid.
    match /coachConversations/{conversationId} {
      // Checked on the ID so the owner can read before the doc exists.
      function ownsConversation() {
        return signedIn() && conversationId.matches('.*_' + request.auth.uid + '$');
      }

      allow read: if ownsConversation();
      allow create, update: if signedIn()
                            && request.resource.data.userId == request.auth.uid
                            && conversationId == request.resource.data.teamId
                            && request.resource.data.teamId.matches('.*_' + request.auth.uid + '$');

      match /messages/{messageId} {
        allow read: if ownsConversation();
        allow create: if signedIn()
                      && ownsConversation()
                      && request.resource.data.role in ['user', 'assistant']
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 4000;
        allow update: if signedIn()
                      && ownsConversation()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suggestionStatus'])
                      && request.resource.data.suggestionStatus in ['applied', 'dismissed'];
      }
    }

    // Use Cases 4 and 12: daily AI request limits. Doc ID is
    // {userId}_{usageDate}_{feature}. The count can only go up by one at a
    // time and never past the feature's limit (keep these numbers in sync
    // with lib/models/ai_feature.dart).
    match /aiUsage/{usageId} {
      function aiLimit(feature) {
        return feature == 'trade_analyzer' ? 10 : 30;
      }

      function validUsage(d) {
        return d.keys().hasOnly(['userId', 'usageDate', 'feature', 'requestCount'])
          && d.userId == request.auth.uid
          && d.feature in ['trade_analyzer', 'assistant_coach']
          && d.usageDate is string
          && d.usageDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && usageId == d.userId + '_' + d.usageDate + '_' + d.feature
          && d.requestCount is int
          && d.requestCount <= aiLimit(d.feature);
      }

      // Matching on the ID lets a user read their own counter even before
      // it exists (the first request of the day).
      allow read: if signedIn()
                  && (usageId.matches('^' + request.auth.uid + '_.*') || isAdmin());
      allow create: if signedIn()
                    && validUsage(request.resource.data)
                    && request.resource.data.requestCount == 1;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && validUsage(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestCount'])
                    && request.resource.data.requestCount == resource.data.requestCount + 1;
      allow delete: if false;
    }
  }
}
